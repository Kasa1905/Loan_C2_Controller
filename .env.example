MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net
# Optional direct (non-SRV) URI fallback used when SRV DNS lookups fail (querySrv EBADRESP/ENOTFOUND)
# Example:
# MONGODB_URI_FALLBACK=mongodb://host1:27017,host2:27017,host3:27017/?replicaSet=atlas-xxxxx-shard-0&tls=true&authSource=admin&retryWrites=true&w=majority
MONGODB_URI_FALLBACK=
MONGODB_DATABASE=test
MONGODB_COLLECTION=finalapplications


C2_HOST=0.0.0.0
C2_PORT=8010

RULE_ENGINE_URL=http://localhost:8001
RULE_ENGINE_ENDPOINT=/policy-rag/evaluate

RISK_ENGINE_URL=http://localhost:8002
RISK_ENGINE_ENDPOINT=/risk/evaluate

REQUEST_TIMEOUT_MS=120000
RISK_SCORE_SCALE=100

